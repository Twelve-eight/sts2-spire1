<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Repo-local cache; relative to this file. Override via NUGET_PACKAGES if needed.
         See .gitignore — .nuget/ is not tracked. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
